# Copiar a .env en servidor de staging (pruebas pre-producción).
# NO commitear .env con secretos reales.

APP_NAME="Hotel MVP Staging"
APP_ENV=staging
APP_KEY=                           # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://staging.tudominio.com

ALLOW_DEV_SETUP_ROUTES=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hoteles_staging
DB_USERNAME=hoteles_staging
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Correo (Mailtrap o SMTP de prueba)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="reservas-staging@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=10080

HOTEL_FOLIO_PREFIX=RES
HOTEL_FOLIO_STAY_PREFIX=FOL
HOTEL_BOOKING_ENABLED=true
HOTEL_BOOKING_MIN_ADVANCE_DAYS=0
HOTEL_BOOKING_MAX_GUESTS=8
HOTEL_BOOKING_NOTIFY_EMAIL=true

# Pagos — opción A: demo (sin tarjeta)
# HOTEL_BOOKING_PAYMENTS_ENABLED=true
# HOTEL_BOOKING_PAYMENT_PROVIDER=demo

# Pagos — opción B: Stripe TEST (recomendado antes de producción)
HOTEL_BOOKING_PAYMENTS_ENABLED=true
HOTEL_BOOKING_PAYMENT_PROVIDER=stripe
HOTEL_BOOKING_DEPOSIT_PERCENT=30
HOTEL_BOOKING_CURRENCY=mxn

STRIPE_SECRET=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

VITE_API_URL=/api
