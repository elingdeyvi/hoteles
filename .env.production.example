# Copiar a .env en el servidor de producción y completar valores reales.
# NO commitear .env con secretos.

APP_NAME="Hotel Costa Azul"
APP_ENV=production
APP_KEY=                           # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://hotel.tudominio.com

ALLOW_DEV_SETUP_ROUTES=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hoteles_prod
DB_USERNAME=hoteles_user
DB_PASSWORD=                         # contraseña fuerte

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Correo real (reservas web)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="reservas@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Token API (opcional, ej. 7 días)
SANCTUM_EXPIRATION=10080

HOTEL_FOLIO_PREFIX=RES
HOTEL_FOLIO_STAY_PREFIX=FOL
HOTEL_BOOKING_ENABLED=true
HOTEL_BOOKING_MIN_ADVANCE_DAYS=0
HOTEL_BOOKING_MAX_GUESTS=8
HOTEL_BOOKING_NOTIFY_EMAIL=true
HOTEL_BOOKING_PAYMENTS_ENABLED=false
HOTEL_BOOKING_PAYMENT_PROVIDER=stripe
HOTEL_BOOKING_DEPOSIT_PERCENT=30
HOTEL_BOOKING_CURRENCY=mxn

# Stripe (producción) — ver docs/PAGOS-STRIPE.md
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Frontend: ruta relativa si Vue y API comparten dominio
VITE_API_URL=/api
