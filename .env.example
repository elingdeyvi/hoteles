# —— Aplicación ——
APP_NAME="Hotel Costa Azul"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Rutas de desarrollo (/api/storage-link). Solo local/testing.
ALLOW_DEV_SETUP_ROUTES=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# —— Base de datos (MySQL) ——
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hoteles
DB_USERNAME=root
DB_PASSWORD=

# —— Sesión / cache ——
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# —— Correo (reservas web) ——
# Desarrollo: MAIL_MAILER=log escribe en storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="recepcion@costaazul.demo"
MAIL_FROM_NAME="${APP_NAME}"

# —— Sanctum (opcional: minutos de vida del token API) ——
# SANCTUM_EXPIRATION=10080

# —— Módulo hotel (config/hotel.php) ——
HOTEL_APP_VERSION=1.0.0
HOTEL_FOLIO_PREFIX=RES
HOTEL_FOLIO_STAY_PREFIX=FOL
HOTEL_BOOKING_ENABLED=true
HOTEL_BOOKING_MIN_ADVANCE_DAYS=0
HOTEL_BOOKING_MAX_GUESTS=8
HOTEL_BOOKING_NOTIFY_EMAIL=true
HOTEL_BOOKING_PAYMENTS_ENABLED=false
HOTEL_BOOKING_PAYMENT_PROVIDER=demo
HOTEL_BOOKING_DEPOSIT_PERCENT=30
HOTEL_BOOKING_CURRENCY=mxn
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=

# —— Frontend (Vite / Vue) ——
VITE_API_URL=/api

# —— Redis / AWS (opcional, no requerido para MVP) ——
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
