# Desarrollo local con SQLite — sin MySQL ni Docker.
# Copiar: cp .env.sqlite.example .env

APP_NAME="Hotel Costa Azul"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

ALLOW_DEV_SETUP_ROUTES=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite (archivo en database/database.sqlite)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="recepcion@costaazul.demo"
MAIL_FROM_NAME="${APP_NAME}"

HOTEL_APP_VERSION=1.0.0
HOTEL_FOLIO_PREFIX=RES
HOTEL_FOLIO_STAY_PREFIX=FOL
HOTEL_BOOKING_ENABLED=true
HOTEL_BOOKING_MIN_ADVANCE_DAYS=0
HOTEL_BOOKING_MAX_GUESTS=8
HOTEL_BOOKING_NOTIFY_EMAIL=true

# Pagos demo activados para probar /reservar sin Stripe
HOTEL_BOOKING_PAYMENTS_ENABLED=true
HOTEL_BOOKING_PAYMENT_PROVIDER=demo
HOTEL_BOOKING_DEPOSIT_PERCENT=30
HOTEL_BOOKING_CURRENCY=mxn

VITE_API_URL=/api
