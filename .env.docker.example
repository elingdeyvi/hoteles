# Copiar a .env cuando uses Docker: cp .env.docker.example .env
# O ejecutar: .\scripts\docker-setup.ps1  /  ./scripts/docker-setup.sh

APP_NAME="Hotel Costa Azul"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

ALLOW_DEV_SETUP_ROUTES=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hoteles
DB_USERNAME=laravel
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="reservas@hotel.demo"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

HOTEL_BOOKING_ENABLED=true
HOTEL_BOOKING_NOTIFY_EMAIL=true
HOTEL_BOOKING_PAYMENTS_ENABLED=true
HOTEL_BOOKING_PAYMENT_PROVIDER=demo
HOTEL_BOOKING_DEPOSIT_PERCENT=30
HOTEL_BOOKING_CURRENCY=mxn

VITE_API_URL=http://localhost:8000/api
